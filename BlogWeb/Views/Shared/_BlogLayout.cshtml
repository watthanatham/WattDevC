@{
    var author = (string)(ViewData["Author"] ?? "Journal");
    var year = DateTime.Now.Year;
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " | " + author : author)</title>
    @if (ViewData["Description"] != null)
    {
        <meta name="description" content="@ViewData["Description"]" />
    }

    <!-- Blog has its own minimal chrome, deliberately independent of the home
         page's 8-bit / formal mode toggle — it always renders clean and
         photo-first. Only the light/dark theme choice still applies. -->
    <script>
        (function () {
            try {
                if (localStorage.getItem('theme') === 'dark') document.documentElement.classList.add('dark');
            } catch (e) {}
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/blog.css" asp-append-version="true" />
</head>
<body class="blog-body">
    <header class="blog-header">
        <div class="container-xl d-flex align-items-center justify-content-between py-4">
            <a href="/blog" class="blog-author-link">@author</a>
            <a href="/" class="blog-back-link">← Portfolio</a>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="blog-footer">
        <p class="text-center small mb-0">&copy; @year @author</p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/blog.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
