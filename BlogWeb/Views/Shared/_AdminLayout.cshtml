@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var links = new (string Href, string Label)[]
    {
        ("/admin", "แดชบอร์ด"),
        ("/admin/posts", "จัดการบล็อก"),
        ("/admin/portfolio", "จัดการ Portfolio"),
    };
    var email = User.Identity?.Name ?? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Admin") | WATT.DEV</title>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-body">
    <div class="d-flex" style="min-height:100vh;">
        <aside class="admin-sidebar d-none d-sm-flex">
            <a href="/" class="fw-bold text-decoration-none text-body" style="font-size:1.125rem;">WATT<span style="color:#6366f1;">.</span>DEV</a>
            <nav class="d-flex flex-column gap-1 mt-4 flex-fill">
                @foreach (var link in links)
                {
                    <a href="@link.Href" class="admin-nav-link">@link.Label</a>
                }
            </nav>
            <div class="border-top pt-3 small" style="border-color:#e4e4e7;">
                <p class="text-truncate mb-2 text-muted">@email</p>
                <form method="post" action="/admin/logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-link p-0 fw-medium text-danger text-decoration-none">ออกจากระบบ</button>
                </form>
            </div>
        </aside>

        <div class="admin-content">
            <header class="admin-topbar d-sm-none">
                <span class="fw-bold">Admin</span>
                <form method="post" action="/admin/logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-link p-0 small fw-medium text-danger text-decoration-none">ออกจากระบบ</button>
                </form>
            </header>
            <nav class="d-flex d-sm-none gap-2 overflow-auto px-3 py-2 border-bottom bg-white">
                @foreach (var link in links)
                {
                    <a href="@link.Href" class="text-nowrap rounded-pill border px-3 py-1 small fw-medium text-decoration-none text-body">@link.Label</a>
                }
            </nav>
            <main class="admin-main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@supabase/supabase-js@2/dist/umd/supabase.js"></script>
    <script>
        window.SUPABASE_CONFIG = {
            url: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Configuration["Supabase:Url"])),
            anonKey: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Configuration["Supabase:AnonKey"])),
            bucket: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Configuration["Supabase:Bucket"])),
        };
    </script>
    <script src="~/js/upload-client.js" asp-append-version="true"></script>
    <script src="~/js/admin-upload-field.js" asp-append-version="true"></script>
    <script src="~/js/admin-common.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
