@model BlogWeb.Models.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>เข้าสู่ระบบ Admin | WATT.DEV</title>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin-body d-flex align-items-center justify-content-center" style="min-height:100vh;">
    <form method="post" action="/admin/login" class="admin-card w-100 mx-3" style="max-width:24rem;">
        @Html.AntiForgeryToken()
        <h1 class="fw-bold" style="font-size:1.25rem;">เข้าสู่ระบบ Admin</h1>
        <p class="text-muted small mt-1">สำหรับจัดการบล็อกและข้อมูล Portfolio</p>

        <div class="mt-4">
            <label class="form-label-admin">อีเมล</label>
            <input type="email" name="Email" value="@Model.Email" required autofocus class="form-control-admin" />
        </div>
        <div class="mt-3">
            <label class="form-label-admin">รหัสผ่าน</label>
            <input type="password" name="Password" required class="form-control-admin" />
        </div>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <p class="text-danger small mt-3 mb-0">@Model.Error</p>
        }

        <button type="submit" class="btn-admin-primary mt-4">เข้าสู่ระบบ</button>
    </form>
</body>
</html>
