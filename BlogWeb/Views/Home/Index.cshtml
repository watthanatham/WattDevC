@model BlogWeb.Models.HomeViewModel
@using BlogWeb.Models
@{
    ViewData["Title"] = null;

    var name = Model.Profile?.Name ?? "Your Name";
    var role = Model.Profile?.Role ?? "Add your role in Admin → Portfolio";
    var nameLines = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);

    string[] categoryOrder = { "frontend", "backend", "mobile", "database", "tools", "other" };
    Dictionary<string, string> categoryLabel = new()
    {
        ["frontend"] = "Frontend", ["backend"] = "Backend", ["mobile"] = "Mobile",
        ["database"] = "Database", ["tools"] = "Tools", ["other"] = "Other",
    };
    var skillsByCategory = Model.Skills
        .GroupBy(s => string.IsNullOrEmpty(s.Category) ? "other" : s.Category)
        .ToDictionary(g => g.Key, g => g.ToList());
    var presentCategories = categoryOrder.Where(skillsByCategory.ContainsKey).ToList();

    Dictionary<string, string> typeLabel = new()
    {
        ["WORK"] = "Full-time", ["FREELANCE"] = "Freelance / Contract", ["EDUCATION"] = "Education",
    };

    var currentCompany = Model.Experiences.FirstOrDefault(e => e.EndDate == null && e.Type != "EDUCATION")?.Company;

    string FormatPeriod(DateTime start, DateTime? end) =>
        $"{start:MMM yyyy} – {(end.HasValue ? end.Value.ToString("MMM yyyy") : "Present")}";

    List<string> SplitLines(string s) => s.Split('\n').Select(x => x.Trim().TrimStart('•', '-', ' ')).Where(x => x.Length > 0).ToList();
    List<string> SplitCsv(string s) => s.Split(',').Select(x => x.Trim()).Where(x => x.Length > 0).ToList();
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400..700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
}

<div class="container home-page">
<div class="home-sections">

    <!-- Hero: a dark panel — name, role, actions, and a colour portrait. -->
    <section class="hero" data-spotlight>
        <div class="hero-body">
            <p class="hero-status"><span class="live-dot" aria-hidden="true"></span>Open to full-time &amp; freelance</p>
            <h1 class="hero-name" aria-label="@name">
                @for (var i = 0; i < nameLines.Length; i++)
                {
                    <span class="line" aria-hidden="true"><span style="--i:@(i + 1)">@nameLines[i]</span></span>
                }
            </h1>
            <div class="hero-copy">
                <p class="hero-role">@role</p>
                @if (!string.IsNullOrEmpty(Model.Profile?.Tagline))
                {
                    <p class="hero-tagline">@Model.Profile.Tagline</p>
                }
                <div class="hero-actions">
                    @if (!string.IsNullOrEmpty(Model.Profile?.Email))
                    {
                        <a href="mailto:@Model.Profile.Email" class="btn btn-accent">Get in touch <span aria-hidden="true">→</span></a>
                    }
                    @if (!string.IsNullOrEmpty(Model.Profile?.ResumeUrl))
                    {
                        <a href="@Model.Profile.ResumeUrl" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Download CV</a>
                    }
                    @if (!string.IsNullOrEmpty(Model.Profile?.Github))
                    {
                        <a href="@Model.Profile.Github" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">GitHub</a>
                    }
                    @if (!string.IsNullOrEmpty(Model.Profile?.Linkedin))
                    {
                        <a href="@Model.Profile.Linkedin" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">LinkedIn</a>
                    }
                </div>
            </div>
        </div>
        <figure class="hero-portrait">
            @if (!string.IsNullOrEmpty(Model.Profile?.AvatarUrl))
            {
                <img src="@Model.Profile.AvatarUrl" alt="@name" fetchpriority="high" />
            }
            else
            {
                <span class="portrait-fallback" aria-hidden="true">@name.FirstOrDefault()</span>
            }
            @if (!string.IsNullOrEmpty(Model.Profile?.Location))
            {
                <figcaption><span class="pin" aria-hidden="true"></span>@Model.Profile.Location</figcaption>
            }
        </figure>
        <dl class="hero-stats">
            @if (Model.Years > 0) { <div><dt>Years of experience</dt><dd>@Model.Years+</dd></div> }
            @if (Model.Projects.Count > 0) { <div><dt>Selected projects</dt><dd>@Model.Projects.Count</dd></div> }
            @if (Model.Skills.Count > 0) { <div><dt>Technologies</dt><dd>@Model.Skills.Count</dd></div> }
        </dl>
    </section>

    <!-- 01 · About + skills -->
    @if (!string.IsNullOrEmpty(Model.Profile?.Bio) || Model.Skills.Count > 0)
    {
        <section id="about" aria-labelledby="about-heading">
            <header class="sec-head reveal">
                <span class="sec-index" aria-hidden="true">01</span>
                <h2 id="about-heading">About</h2>
            </header>
            @if (!string.IsNullOrEmpty(Model.Profile?.Bio))
            {
                <div class="about-layout">
                    <p class="about-bio reveal">@Model.Profile.Bio</p>
                    <dl class="about-facts">
                        @if (!string.IsNullOrEmpty(Model.Profile?.Location))
                        {
                            <div class="fact reveal"><dt>Based in</dt><dd>@Model.Profile.Location</dd></div>
                        }
                        @if (Model.Years > 0)
                        {
                            <div class="fact reveal"><dt>Experience</dt><dd>@Model.Years+ years</dd></div>
                        }
                        @if (!string.IsNullOrEmpty(currentCompany))
                        {
                            <div class="fact reveal"><dt>Currently</dt><dd>@currentCompany</dd></div>
                        }
                    </dl>
                </div>
            }
            @if (Model.Skills.Count > 0)
            {
                <div class="skills">
                    <h3 class="sub-title reveal">Skills &amp; tools <span class="count">@Model.Skills.Count</span></h3>
                    <div class="skill-grid">
                        @foreach (var cat in presentCategories)
                        {
                            var items = skillsByCategory[cat];
                            <article class="skill-card reveal" style="--span:@(items.Count >= 4 ? 3 : 2)">
                                <header>
                                    <h4>@categoryLabel[cat]</h4>
                                    <span class="count">@items.Count</span>
                                </header>
                                <ul class="chips">
                                    @foreach (var s in items)
                                    {
                                        <li class="chip">@if (!string.IsNullOrEmpty(s.IconUrl)) {<img src="@s.IconUrl" alt="" loading="lazy" />}@s.Name</li>
                                    }
                                </ul>
                            </article>
                        }
                    </div>
                </div>
            }
        </section>
    }

    <!-- 02 · Experience -->
    <section id="experience" aria-labelledby="experience-heading">
        <header class="sec-head reveal">
            <span class="sec-index" aria-hidden="true">02</span>
            <h2 id="experience-heading">Experience</h2>
        </header>
        @if (Model.Experiences.Count == 0)
        {
            <p class="block-empty">Experience details are coming soon.</p>
        }
        else
        {
            <ol class="xp">
                @foreach (var exp in Model.Experiences)
                {
                    var highlights = SplitLines(exp.Highlights);
                    var techs = SplitCsv(exp.Tech);
                    <li class="xp-card reveal">
                        <aside class="xp-meta">
                            <span class="xp-badge" aria-hidden="true">@exp.Company.FirstOrDefault()</span>
                            <p class="xp-company">@exp.Company</p>
                            <p class="xp-period">@FormatPeriod(exp.StartDate, exp.EndDate)</p>
                            <p class="xp-tags">
                                <span class="tag">@(typeLabel.GetValueOrDefault(exp.Type, exp.Type))</span>
                                @if (exp.EndDate == null) { <span class="tag tag-live"><span class="live-dot" aria-hidden="true"></span>Current</span> }
                            </p>
                        </aside>
                        <div class="xp-body">
                            <h3 class="xp-role">@exp.Role</h3>
                            @if (!string.IsNullOrWhiteSpace(exp.Summary))
                            {
                                <p class="xp-summary">@exp.Summary</p>
                            }
                            @if (highlights.Count > 0)
                            {
                                <h4 class="xp-subhead">Responsibilities and highlights <span class="count">@highlights.Count</span></h4>
                                <ol class="xp-highlights">
                                    @foreach (var h in highlights) { <li class="reveal">@h</li> }
                                </ol>
                            }
                            @if (techs.Count > 0)
                            {
                                <ul class="chips chips-sm" aria-label="Technologies">
                                    @foreach (var t in techs) { <li class="chip">@t</li> }
                                </ul>
                            }
                        </div>
                    </li>
                }
            </ol>
        }
    </section>

    <!-- 03 · Projects: first one featured wide, the rest in a two-up grid. -->
    <section id="projects" aria-labelledby="projects-heading">
        <header class="sec-head reveal">
            <span class="sec-index" aria-hidden="true">03</span>
            <h2 id="projects-heading">Projects</h2>
            <p>Problems, systems, and the work behind them.</p>
        </header>
        @if (Model.Projects.Count == 0)
        {
            <p class="block-empty">Project details are coming soon.</p>
        }
        else
        {
            <div class="project-grid">
                @for (var i = 0; i < Model.Projects.Count; i++)
                {
                    var p = Model.Projects[i];
                    <article class="project-card reveal @(i == 0 ? "is-featured" : "")">
                        @if (!string.IsNullOrEmpty(p.ImageUrl))
                        {
                            <div class="project-media"><img src="@p.ImageUrl" alt="@p.Title" loading="lazy" /></div>
                        }
                        <div class="project-main">
                            <div class="project-top">
                                <span class="project-no" aria-hidden="true">@((i + 1).ToString("D2"))</span>
                                @if (!string.IsNullOrEmpty(p.Link))
                                {
                                    <a href="@p.Link" target="_blank" rel="noopener noreferrer" class="icon-link" aria-label="View @p.Title">↗</a>
                                }
                            </div>
                            <h3>@p.Title</h3>
                            <p class="project-desc">@p.Description</p>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(p.Result) || !string.IsNullOrWhiteSpace(p.Problem) || !string.IsNullOrWhiteSpace(p.Solution))
                        {
                            <div class="project-side">
                                @if (!string.IsNullOrWhiteSpace(p.Result))
                                {
                                    <div class="project-outcome">
                                        <p class="label">Outcome</p>
                                        <p>@p.Result</p>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(p.Problem) || !string.IsNullOrWhiteSpace(p.Solution))
                                {
                                    <details class="case">
                                        <summary>Read case study</summary>
                                        @if (!string.IsNullOrWhiteSpace(p.Problem))
                                        {
                                            <h4>Problem</h4>
                                            <p>@p.Problem</p>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(p.Solution))
                                        {
                                            <h4>Approach</h4>
                                            <p>@p.Solution</p>
                                        }
                                    </details>
                                }
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </section>

    <!-- Blog -->
    @if (Model.LatestPosts.Count > 0)
    {
        <section id="blog" aria-labelledby="blog-heading">
            <header class="sec-head sec-head-row reveal">
                <h2 id="blog-heading">From the blog</h2>
                <a href="/blog" class="text-link">All posts <span aria-hidden="true">→</span></a>
            </header>
            <div class="row row-cols-1 row-cols-sm-3 g-4">
                @foreach (var post in Model.LatestPosts)
                {
                    <div class="col reveal">
                        <a href="/blog/@post.Slug" class="post-card text-decoration-none d-block">
                            <div class="post-card-cover">
                                @if (!string.IsNullOrEmpty(post.CoverImage))
                                {
                                    <img src="@post.CoverImage" alt="@post.Title" />
                                }
                                else
                                {
                                    <div class="post-card-placeholder">@BlogWeb.Services.BlogHelpers.CategoryLabel(post.Category)</div>
                                }
                            </div>
                            <p class="post-card-cat mb-0 mt-3">@BlogWeb.Services.BlogHelpers.CategoryLabel(post.Category)</p>
                            <h3 class="post-card-title">@post.Title</h3>
                            <p class="post-card-date">@post.CreatedAt.ToString("MMM d, yyyy")</p>
                        </a>
                    </div>
                }
            </div>
        </section>
    }

    <!-- Contact: closes the page with the same dark panel as the hero. -->
    <section id="contact" class="contact reveal" aria-labelledby="contact-heading">
        <p class="hero-status"><span class="live-dot" aria-hidden="true"></span>Open to full-time and freelance opportunities.</p>
        <h2 id="contact-heading">Let's work together.</h2>
        @if (!string.IsNullOrEmpty(Model.Profile?.Email))
        {
            <a href="mailto:@Model.Profile.Email" class="contact-mail">@Model.Profile.Email <span aria-hidden="true">→</span></a>
        }
        <div class="hero-actions">
            @if (!string.IsNullOrEmpty(Model.Profile?.Github)) { <a href="@Model.Profile.Github" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">GitHub</a> }
            @if (!string.IsNullOrEmpty(Model.Profile?.Linkedin)) { <a href="@Model.Profile.Linkedin" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">LinkedIn</a> }
            @if (!string.IsNullOrEmpty(Model.Profile?.ResumeUrl)) { <a href="@Model.Profile.ResumeUrl" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Download CV</a> }
        </div>
    </section>

</div>
</div>
